//@version=6
//=====================================================================
// SuperTrend Breakout — EMA gate, prior-high entry, scale-out
// PUT THIS ON A 1-HOUR CHART.
//=====================================================================
//
// FILTER  (daily)  close > EMA50 AND close > EMA200. Nothing else. Armed until
//                  either average is lost - that loss is also an exit.
// ENTRY   (1h)     first close above the PREVIOUS completed daily high while
//                  armed. Re-entry is allowed: one window can produce several
//                  breakouts in sequence, and each carries its number (#1, #2...).
// STOP             the 1h SuperTrend at entry. Fixed, does not trail.
// MANAGE           +1R   -> stop to breakeven
//                  +1.5R -> sell half, remainder runs on the breakeven stop
// EXIT             stop, or the gate disarming.
//
// Every choice above was measured. The rejected alternatives - daily SuperTrend
// gate, hysteresis buffers, EMA stacking, relative-strength filtering, tighter
// ATR/percentage stops, chandelier and swing trailing, RSI confirmation, a faster
// 1h SuperTrend - all scored worse. See FINDINGS.md.
//
//---------------------------------------------------------------------
// Three things that keep this honest rather than flattering:
//
// 1. Daily values are requested as expr[1] - the LAST CLOSED daily bar. On an
//    intraday chart a plain request returns the developing daily bar, which
//    changes as the session runs and was not knowable at the time. It also means
//    the breakout level is YESTERDAY's high, held flat across today.
//
// 2. Breakeven arms from the bar AFTER +1R is reached, not the same bar. Moving
//    the stop up on the strength of the same bar's high would let a trade that
//    spiked to +1R and then collapsed exit at breakeven instead of at its real
//    stop - a small lie that flatters every runner.
//
// 3. The scale-out is a LIMIT leg, so it fills at the level. Closing at market
//    instead fills at the bar close, which on a fast bar is nowhere near the
//    target and quietly understates every winner.
//
// The Strategy Tester still will not match backtest/run_exits.py exactly: the
// Python model checks the stop before the target within a bar and fills gaps at
// the open, while Pine applies its own intrabar assumptions.
//=====================================================================

strategy("SuperTrend Breakout — EMA gate, 1h entry",
     overlay                 = true,
     initial_capital         = 100000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.1,
     process_orders_on_close = true,
     calc_on_every_tick      = false,
     max_labels_count        = 500)

//=====================================================================
// Inputs
//=====================================================================
G_F = "1 - Filter (daily)"
emaFast = input.int(50,  "Fast EMA", minval = 1, group = G_F)
emaSlow = input.int(200, "Slow EMA", minval = 1, group = G_F)

G_E = "2 - Entry (1h)"
useBreakout = input.bool(true, "Entry on prior-day high breakout", group = G_E,
     tooltip = "Off = enter on a 1h SuperTrend flip instead. The breakout leaves " +
               "8% of armed windows unused against 36% for the flip.")
minRisk = input.float(0.3, "Skip if stop is nearer than (%)", minval = 0.0, step = 0.1,
     group = G_E,
     tooltip = "R divides by the stop distance. A stop a whisker away produces " +
               "meaningless 200R outliers and an enormous position.")

G_S = "3 - Stop"
stFactor = input.float(3.0, "1h SuperTrend factor", minval = 0.1, step = 0.1, group = G_S,
     tooltip = "Wider beat tighter in testing: 2xATR and 2% stops are hit by noise " +
               "before the move develops.")
stAtr = input.int(10, "1h SuperTrend ATR length", minval = 1, group = G_S)

G_M = "4 - Management"
beAt     = input.float(1.0, "Stop to breakeven at (R)", minval = 0.0, step = 0.1, group = G_M,
     tooltip = "0 disables the breakeven move.")
partialR = input.float(1.5, "Scale out at (R)", minval = 0.1, step = 0.1, group = G_M)
partPct  = input.int(50, "Percent to scale out", minval = 0, maxval = 99, group = G_M,
     tooltip = "0 disables the scale-out; the whole position then runs on the stop.")

G_V = "5 - Display"
showState = input.bool(true, "Live state table", group = G_V)
showCard  = input.bool(true, "Strategy card", group = G_V)
showLvls  = input.bool(true, "Entry / stop / scale-out lines", group = G_V)
showTrig  = input.bool(true, "Breakout level", group = G_V)
showBg    = input.bool(true, "Shade armed window", group = G_V)
showNums  = input.bool(true, "Number each entry", group = G_V)
showBlock = input.bool(true, "Mark triggers the filter refused", group = G_V)

//=====================================================================
// Daily context — last CLOSED daily bar only
//=====================================================================
f_daily() =>
    ef = ta.ema(close, emaFast)
    es = ta.ema(close, emaSlow)
    [ef[1], es[1], close[1], high[1]]

[dEf, dEs, dClose, dHigh] =
     request.security(syminfo.tickerid, "D", f_daily(), lookahead = barmerge.lookahead_off)

armed     = not na(dEf) and not na(dEs) and dClose > dEf and dClose > dEs
justArmed = armed and not armed[1]
disarmed  = not armed and armed[1]

//=====================================================================
// 1h SuperTrend — the stop, and optionally the trigger
//=====================================================================
[stLine, stDir] = ta.supertrend(stFactor, stAtr)
stBull   = stDir < 0
stFlipUp = stBull and not stBull[1]

//=====================================================================
// State
//=====================================================================
var float entryPx  = na
var float initStop = na
var float riskPx   = na
var float tpPx     = na
var bool  beArmed  = false   // set at the CLOSE of the bar that reached +beAt R
var int   winCount = 0       // entries so far in the current armed window
var int   entryNo  = 0

if justArmed
    winCount := 0

flat     = strategy.position_size == 0
trigger  = useBreakout ? (not na(dHigh) and close > dHigh) : stFlipUp
stopOk   = not na(stLine) and stLine < close and 100.0 * (close - stLine) / close >= minRisk
takeLong = armed and flat and trigger and stopOk

if takeLong
    entryPx  := close
    initStop := stLine
    riskPx   := close - stLine
    tpPx     := close + partialR * riskPx
    beArmed  := false
    winCount += 1
    entryNo  := winCount
    strategy.entry("L", strategy.long)

inPos = strategy.position_size > 0

// beArmed was set on a PREVIOUS bar's close - see note 2 in the header.
curStop = inPos ? (beArmed ? math.max(nz(initStop), nz(entryPx)) : initStop) : na

if inPos and not na(curStop)
    if partPct > 0
        strategy.exit("scale", "L", qty_percent = partPct, limit = tpPx, stop = curStop)
    strategy.exit("stop", "L", stop = curStop)

if inPos and not armed
    strategy.close_all(comment = "disarm")

if inPos and beAt > 0 and not na(entryPx) and high >= entryPx + beAt * riskPx
    beArmed := true

if flat and not flat[1]
    entryPx  := na
    initStop := na
    riskPx   := na
    tpPx     := na
    beArmed  := false
    entryNo  := 0

openR   = inPos and not na(entryPx) and riskPx > 0 ? (close - entryPx) / riskPx : na
riskPct = not na(entryPx) and not na(initStop) and entryPx > 0 ?
     100 * (entryPx - initStop) / entryPx : na

//=====================================================================
// Plots — all on the price axis
//=====================================================================
bgcolor(showBg and armed ? color.new(color.teal, 92) : na, title = "Armed")

plot(showTrig and useBreakout ? dHigh : na, "Breakout level (prior daily high)",
     color = color.new(color.orange, 20), style = plot.style_stepline, linewidth = 2)
plot(stLine, "1h SuperTrend",
     color = stBull ? color.new(color.teal, 45) : color.new(color.red, 45),
     style = plot.style_linebr)

plot(showLvls and inPos ? entryPx : na, "Entry",
     color = color.new(color.blue, 0), style = plot.style_linebr, linewidth = 2)
plot(showLvls and inPos ? curStop : na, "Stop",
     color = color.new(color.red, 0), style = plot.style_linebr, linewidth = 2)
plot(showLvls and inPos and partPct > 0 ? tpPx : na, "Scale-out level",
     color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 2)

plotshape(takeLong and not showNums, "Entry", shape.triangleup, location.belowbar,
     color.new(color.teal, 0), size = size.tiny)
plotshape(disarmed, "Disarm", shape.xcross, location.abovebar,
     color.new(color.gray, 30), size = size.tiny)
plotshape(showBlock and not armed and flat and trigger and not trigger[1],
     "Refused by the filter", shape.circle, location.belowbar,
     color.new(color.gray, 60), size = size.tiny)

if showNums and takeLong
    label.new(bar_index, low, "#" + str.tostring(winCount), style = label.style_label_up,
         color = color.new(color.teal, 0), textcolor = color.white, size = size.tiny)

//=====================================================================
// Tables
//=====================================================================
f_sign(float v, string fmt) => (v >= 0 ? "+" : "") + str.tostring(v, fmt)

f_cell(table tb, int c, int r, string s, color col, bool right) =>
    table.cell(tb, c, r, s, text_color = col, text_size = size.small,
         text_halign = right ? text.align_right : text.align_left)

var table live = table.new(position.top_right, 2, 12, border_width = 1,
     frame_width = 1, frame_color = color.new(color.gray, 60))
var table card = table.new(position.bottom_right, 2, 14, border_width = 1,
     frame_width = 1, frame_color = color.new(color.gray, 60))

// islastconfirmedhistory as well as islast: with calc_on_every_tick off the
// realtime bar never sets islast, so a table would vanish while a market is open.
if barstate.islast or barstate.islastconfirmedhistory
    ok  = color.new(color.teal, 0)
    no  = color.new(color.red, 0)
    dim = color.new(color.silver, 0)
    key = color.new(color.gray, 20)

    if showState
        f_cell(live, 0, 0, "chart TF", key, false)
        f_cell(live, 1, 0, timeframe.period + (timeframe.period == "60" ? "" : "  USE 60"),
             timeframe.period == "60" ? dim : no, true)
        f_cell(live, 0, 1, "daily close", key, false)
        f_cell(live, 1, 1, str.tostring(nz(dClose), "#.##"), dim, true)
        f_cell(live, 0, 2, "EMA" + str.tostring(emaFast) + " / EMA" + str.tostring(emaSlow), key, false)
        f_cell(live, 1, 2, str.tostring(nz(dEf), "#.##") + " / " + str.tostring(nz(dEs), "#.##"),
             armed ? ok : no, true)
        f_cell(live, 0, 3, "ARMED", key, false)
        f_cell(live, 1, 3, armed ? "YES" : "no", armed ? ok : no, true)
        f_cell(live, 0, 4, useBreakout ? "breakout above" : "1h flip", key, false)
        f_cell(live, 1, 4, useBreakout ? str.tostring(nz(dHigh), "#.##") + "  (" +
             f_sign(100 * (nz(dHigh) - close) / close, "#.#") + "%)" :
             (stBull ? "bullish" : "bearish"), trigger ? ok : dim, true)
        f_cell(live, 0, 5, "1h SuperTrend", key, false)
        f_cell(live, 1, 5, str.tostring(nz(stLine), "#.##"), dim, true)
        f_cell(live, 0, 6, "entries this window", key, false)
        f_cell(live, 1, 6, str.tostring(winCount), winCount > 0 ? ok : dim, true)
        f_cell(live, 0, 7, "position", key, false)
        f_cell(live, 1, 7, inPos ? ("LONG #" + str.tostring(entryNo)) :
             (armed ? "waiting" : "flat"), inPos ? ok : dim, true)
        f_cell(live, 0, 8, "entry", key, false)
        f_cell(live, 1, 8, inPos ? str.tostring(entryPx, "#.##") : "-", dim, true)
        f_cell(live, 0, 9, "stop", key, false)
        f_cell(live, 1, 9, inPos ? str.tostring(curStop, "#.##") +
             (beArmed ? "  BE" : "  (-" + str.tostring(riskPct, "#.#") + "%)") : "-",
             inPos ? no : dim, true)
        f_cell(live, 0, 10, "scale out at", key, false)
        f_cell(live, 1, 10, inPos and partPct > 0 ? str.tostring(tpPx, "#.##") +
             "  (" + str.tostring(partialR, "#.#") + "R)" : "-", inPos ? ok : dim, true)
        f_cell(live, 0, 11, "open R", key, false)
        f_cell(live, 1, 11, inPos ? f_sign(openR, "#.##") + "R" : "-",
             inPos and openR >= 0 ? ok : (inPos ? no : dim), true)

    // The card states the whole strategy, so a screenshot documents itself.
    if showCard
        pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
        closed = strategy.wintrades + strategy.losstrades
        f_cell(card, 0, 0, "STRATEGY", key, false)
        f_cell(card, 1, 0, "SuperTrend Breakout", ok, true)
        f_cell(card, 0, 1, "filter (D)", key, false)
        f_cell(card, 1, 1, "close > EMA" + str.tostring(emaFast) + " and EMA" +
             str.tostring(emaSlow), dim, true)
        f_cell(card, 0, 2, "entry (1h)", key, false)
        f_cell(card, 1, 2, useBreakout ? "close > prior daily high" : "1h SuperTrend flip up",
             dim, true)
        f_cell(card, 0, 3, "re-entry", key, false)
        f_cell(card, 1, 3, "yes, while armed", dim, true)
        f_cell(card, 0, 4, "stop", key, false)
        f_cell(card, 1, 4, "1h SuperTrend(" + str.tostring(stFactor, "#.#") + ", ATR" +
             str.tostring(stAtr) + ") at entry, fixed", dim, true)
        f_cell(card, 0, 5, "min risk", key, false)
        f_cell(card, 1, 5, str.tostring(minRisk, "#.#") + "% of price", dim, true)
        f_cell(card, 0, 6, "breakeven", key, false)
        f_cell(card, 1, 6, beAt > 0 ? "at " + str.tostring(beAt, "#.#") + "R (next bar)" : "off",
             dim, true)
        f_cell(card, 0, 7, "scale out", key, false)
        f_cell(card, 1, 7, partPct > 0 ? str.tostring(partPct) + "% at " +
             str.tostring(partialR, "#.#") + "R (limit)" : "off", dim, true)
        f_cell(card, 0, 8, "runner", key, false)
        f_cell(card, 1, 8, "breakeven stop until disarm", dim, true)
        f_cell(card, 0, 9, "exit", key, false)
        f_cell(card, 1, 9, "stop, or either EMA lost", dim, true)
        f_cell(card, 0, 10, "commission", key, false)
        f_cell(card, 1, 10, "0.1% per side", dim, true)
        f_cell(card, 0, 11, "- results -", key, false)
        f_cell(card, 1, 11, "", dim, true)
        f_cell(card, 0, 12, "closed W / L", key, false)
        f_cell(card, 1, 12, str.tostring(strategy.wintrades) + " / " +
             str.tostring(strategy.losstrades) + (closed > 0 ? "   " +
             str.tostring(100.0 * strategy.wintrades / closed, "#.#") + "%" : ""),
             strategy.wintrades >= strategy.losstrades ? ok : dim, true)
        f_cell(card, 0, 13, "profit factor / net", key, false)
        f_cell(card, 1, 13, (na(pf) ? "-" : str.tostring(pf, "#.##")) + "   " +
             f_sign(100 * strategy.netprofit / strategy.initial_capital, "#.#") + "%",
             strategy.netprofit >= 0 ? ok : no, true)
